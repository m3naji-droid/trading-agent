# ======== الإعدادات الأساسية ========
# paper = محاكاة بأموال وهمية (ابدأ بها) | testnet = حساب Binance التجريبي | live = حقيقي
MODE=paper
DASHBOARD_PASSWORD=ضع-كلمة-مرور-قوية-هنا
PAPER_START_BALANCE=300

# ======== مفاتيح Binance (اتركها فارغة في وضع paper) ========
# صلاحيات المفتاح: Enable Reading + Enable Spot & Margin Trading + Enable Futures فقط
# ❌ لا تفعّل Enable Withdrawals أبداً — الوكيل يرفض العمل إذا كانت مفعلة
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ======== المخاطر (القيم الافتراضية مدروسة، لا حاجة لتغييرها) ========
RISK_MIN=0.01
RISK_MAX=0.02
RISK_REDUCED=0.005
LOSS_STREAK_TRIGGER=3
MAX_DAILY_DRAWDOWN=0.06
MAX_LEVERAGE=5
MAX_OPEN_POSITIONS=4

# ======== العملات الميمية (خانة خاصة بقواعد أشد) ========
MEME_SLOTS=5
MEME_RISK_MULT=0.5
MEME_MAX_LEVERAGE=2
MEME_MAX_POSITIONS=1

# ======== نطاق المسح ========
UNIVERSE_SIZE=30
MIN_QUOTE_VOLUME=20000000
SCAN_INTERVAL_SEC=60
